# Which role this deployment plays. A = payer bank, B = receiving bank.
BANK_ID=A
BANK_NAME=Bank A
PEER_BANK_ID=B
PEER_BANK_URL=http://localhost:8082
# stub = canned responses, works offline. vertex = real Gemini on Vertex AI.
GEMINI_MODE=stub
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LOCATION=us-central1
GOOGLE_CLOUD_PROJECT=second-voice-demo
# Local emulator. Unset in Cloud Run.
FIRESTORE_EMULATOR_HOST=localhost:8080
# Seconds a customer must wait before an override is accepted on a held payment.
COOLING_OFF_SECONDS=10
# Hours an inflow is held on a High-band receiver account.
HOLD_HOURS=24
